# Where "Open SYNAPSE", "Sign in" and "Create a workspace" go: the web ERP's origin.
VITE_ERP_URL=https://synapse-lzsdm.ondigitalocean.app

# The Android build to download. A path is served from public/ (put the file at
# public/downloads/synapse.apk), or give a full URL (a release asset, a bucket).
VITE_APK_URL=/downloads/synapse.apk
