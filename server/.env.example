APP_NAME=SYNAPSE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Proxies whose X-Forwarded-For is believed (comma-separated, or *); empty trusts none.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — keep exactly ONE of the two blocks below uncommented.
# Local
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=synapse
DB_USERNAME=postgres
DB_PASSWORD=password
DB_SSLMODE=prefer

# Supabase (Dashboard → Connect → Session pooler). Host looks like
# aws-0-<region>.pooler.supabase.com, username like postgres.<project-ref>.
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require
# Supabase Storage — uncomment to keep uploads in Supabase instead of
# storage/app/public (local needs `php artisan storage:link`). Keys come from
# Dashboard → Storage → S3 Connection; the bucket must be marked Public.
#   ENDPOINT: https://<project-ref>.storage.supabase.co/storage/v1/s3
#   URL:      https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# SUPABASE_STORAGE_KEY=
# SUPABASE_STORAGE_SECRET=
# SUPABASE_STORAGE_REGION=
# SUPABASE_STORAGE_BUCKET=
# SUPABASE_STORAGE_ENDPOINT=
# SUPABASE_STORAGE_URL=
# Data Export archives — a second bucket, marked PRIVATE (never the public one
# above), using the same keys. Unset, archives go to storage/app/private/exports,
# which a container redeploy wipes.
# SUPABASE_EXPORTS_BUCKET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS) so session/XSRF cookies are sent only over TLS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email delivery. Local dev can use "log" (writes mail to the log instead of
# sending). Email verification is enforced, so configure a real mailer in any
# environment where users must confirm their address. Default transport is
# Brevo over SMTP — create an SMTP key in the Brevo dashboard.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


VITE_APP_NAME="${APP_NAME}"

# Google Gemini (server-side agentic assistant)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Synapse ML inference service (FastAPI — see model/api). Run it with
# `python -m api` from the model/ directory. Called server-side only.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT=30
ML_SERVICE_TRAIN_TIMEOUT=300

# Privacy Policy and Terms of Service (/privacy, /terms — ADR 0063). Who runs this
# deployment, as the documents name them. Set these for every real deployment.
LEGAL_OPERATOR="${APP_NAME}"
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_ADDRESS=
# true only when GEMINI_API_KEY is on a paid plan (Google then does not use what is
# sent to improve its products). The Privacy Policy states which applies.
LEGAL_AI_PAID_PLAN=false
